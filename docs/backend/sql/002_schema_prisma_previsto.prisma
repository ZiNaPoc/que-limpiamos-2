/// Participación de un trabajador en una solicitud (invitación o bolsa). Una fila por par.
model solicitud_trabajadores {
  id                    Int                                   @id @default(autoincrement())
  solicitud_id          Int
  trabajador_id         Int
  origen                solicitud_trabajadores_origen
  estado                solicitud_trabajadores_estado         @default(PENDIENTE)
  motivo_cierre         solicitud_trabajadores_motivo_cierre?
  created_at            DateTime                              @default(now()) @db.DateTime(0)
  respondida_en         DateTime?                             @db.DateTime(0)
  updated_at            DateTime                              @updatedAt @default(now()) @db.DateTime(0)
  /// Columna GENERADA por la BD (VIRTUAL). Nunca escribirla.
  aceptada_solicitud_id Int?                                  @unique(map: "uq_st_una_aceptada") @ignore
  solicitudes solicitudes @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_st_solicitud")
  trabajadores trabajadores @relation(fields: [trabajador_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_st_trabajador")

  @@unique([solicitud_id, trabajador_id], map: "uq_st_solicitud_trabajador")
  @@index([trabajador_id, estado], map: "idx_st_trabajador_estado")
  @@index([solicitud_id, estado], map: "idx_st_solicitud_estado")
}

