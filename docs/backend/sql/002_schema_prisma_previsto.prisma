// ESQUEMA PRISMA PREVISTO tras el SQL 002 (v10) — NO es el schema activo.
// Se copia a prisma/schema.prisma solo DESPUÉS de ejecutar el SQL y verificarlo.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model documentos_cliente {
  id          Int                     @id @default(autoincrement())
  usuario_id  Int
  tipo        documentos_cliente_tipo
  archivo_url String                  @db.VarChar(255)
  created_at  DateTime                @default(now()) @db.DateTime(0)
  usuarios    usuarios                @relation("documentos_cliente_dueno", fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_cliente_usuario")
  estado         documentos_cliente_estado @default(PENDIENTE)
  motivo_rechazo String?                   @db.VarChar(255)
  revisado_en    DateTime?                 @db.DateTime(0)
  revisado_por   Int?
  archivo_eliminado_en DateTime?                 @db.DateTime(0)
  revisor usuarios? @relation("documentos_cliente_revisor", fields: [revisado_por], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_doc_cliente_revisor")

  @@unique([usuario_id, tipo], map: "uq_doc_cliente_tipo")
  @@index([revisado_por], map: "idx_doc_cliente_revisor")
}

model documentos_trabajador {
  id            Int                        @id @default(autoincrement())
  trabajador_id Int
  tipo          documentos_trabajador_tipo
  archivo_url   String                     @db.VarChar(255)
  created_at    DateTime                   @default(now()) @db.DateTime(0)
  trabajadores  trabajadores               @relation(fields: [trabajador_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_trabajador")
  estado         documentos_trabajador_estado @default(PENDIENTE)
  motivo_rechazo String?                      @db.VarChar(255)
  revisado_en    DateTime?                    @db.DateTime(0)
  revisado_por   Int?
  archivo_eliminado_en DateTime?                    @db.DateTime(0)
  revisor usuarios? @relation("documentos_trabajador_revisor", fields: [revisado_por], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_doc_trabajador_revisor")

  @@unique([trabajador_id, tipo], map: "uq_doc_trabajador_tipo")
  @@index([revisado_por], map: "idx_doc_trabajador_revisor")
}

model evidencias_solicitud {
  id           Int         @id @default(autoincrement())
  solicitud_id Int
  archivo_url  String      @db.VarChar(255)
  descripcion  String?     @db.VarChar(255)
  created_at   DateTime    @default(now()) @db.DateTime(0)
  solicitudes  solicitudes @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evid_solicitud")
  aportada_por evidencias_solicitud_aportada_por @default(TRABAJADOR)
  reporte_id   Int?
  solicitud_reportes solicitud_reportes? @relation(fields: [reporte_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_evid_reporte")

  @@index([solicitud_id], map: "fk_evid_solicitud")
  @@index([reporte_id], map: "idx_evid_reporte")
}

model notificaciones {
  id           Int                 @id @default(autoincrement())
  usuario_id   Int
  solicitud_id Int?
  tipo         notificaciones_tipo
  titulo       String              @db.VarChar(100)
  mensaje      String              @db.VarChar(255)
  created_at   DateTime            @default(now()) @db.DateTime(0)
  solicitudes  solicitudes?        @relation(fields: [solicitud_id], references: [id], onUpdate: NoAction, map: "fk_notif_solicitud")
  usuarios     usuarios            @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notif_usuario")
  leida_en     DateTime?           @db.DateTime(0)

  @@index([solicitud_id], map: "fk_notif_solicitud")
  @@index([usuario_id], map: "fk_notif_usuario")
  @@index([usuario_id, leida_en], map: "idx_notif_usuario_leida")
}

model password_reset_tokens {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  token_hash String   @unique(map: "uq_reset_token") @db.Char(64)
  expira_en  DateTime @db.DateTime(0)
  usado      Boolean  @default(false)
  created_at DateTime @default(now()) @db.DateTime(0)
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reset_usuario")

  @@index([usuario_id], map: "fk_reset_usuario")
}

model resenas {
  id                    Int         @id @default(autoincrement())
  solicitud_id          Int         @unique(map: "uq_resena_solicitud")
  puntuacion_servicio   Int         @db.TinyInt
  puntuacion_trabajador Int         @db.TinyInt
  comentario            String?     @db.Text
  created_at            DateTime    @default(now()) @db.DateTime(0)
  solicitudes           solicitudes @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_resena_solicitud")
}

model servicios {
  id                    Int                    @id @default(autoincrement())
  nombre                String                 @unique(map: "uq_servicios_nombre") @db.VarChar(100)
  descripcion           String                 @db.Text
  precio_base           Decimal                @db.Decimal(10, 2)
  duracion_estimada_min Int                    @default(300) @db.UnsignedSmallInt
  imagen_url            String?                @db.VarChar(255)
  estado                servicios_estado       @default(ACTIVO)
  created_at            DateTime               @default(now()) @db.DateTime(0)
  updated_at            DateTime               @updatedAt @default(now()) @db.DateTime(0)
  solicitudes           solicitudes[]
  trabajador_servicios  trabajador_servicios[]
  servicio_calculo               servicio_calculo?
  servicio_calculo_tipo_inmueble servicio_calculo_tipo_inmueble[]
  servicio_especialidades        servicio_especialidades[]
  descuento_servicios            descuento_servicios[]
}

model solicitudes {
  id                    Int                    @id @default(autoincrement())
  cliente_id            Int
  servicio_id           Int
  inmueble_id           Int?
  trabajador_id         Int?
  fecha_hora_programada DateTime               @db.DateTime(0)
  direccion_servicio    String                 @db.VarChar(255)
  precio_estimado       Decimal                @db.Decimal(10, 2)
  estado                solicitudes_estado     @default(PENDIENTE)
  created_at            DateTime               @default(now()) @db.DateTime(0)
  updated_at            DateTime               @updatedAt @default(now()) @db.DateTime(0)
  evidencias_solicitud  evidencias_solicitud[]
  notificaciones        notificaciones[]
  resenas               resenas?
  usuarios              usuarios               @relation(fields: [cliente_id], references: [id], onUpdate: NoAction, map: "fk_sol_cliente")
  inmuebles             inmuebles?             @relation(fields: [inmueble_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_sol_inmueble")
  servicios             servicios              @relation(fields: [servicio_id], references: [id], onUpdate: NoAction, map: "fk_sol_servicio")
  trabajadores          trabajadores?          @relation(fields: [trabajador_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_sol_trabajador")
  servicio_nombre_aplicado       String?                            @db.VarChar(100)
  inmueble_tipo_aplicado         solicitudes_inmueble_tipo_aplicado?
  habitaciones_aplicado          Int?                               @db.UnsignedTinyInt
  banos_aplicado                 Int?                               @db.UnsignedTinyInt
  medios_banos_aplicado          Int?                               @db.UnsignedTinyInt
  pisos_aplicado                 Int?                               @db.UnsignedTinyInt
  duracion_estimada_min          Int?                               @db.UnsignedSmallInt
  fecha_hora_fin_estimada        DateTime?                          @db.DateTime(0)
  notas                          String?                            @db.Text
  precio_base_aplicado           Decimal?                           @db.Decimal(10, 2)
  precio_tamano_aplicado         Decimal?                           @db.Decimal(10, 2)
  precio_ajuste_tipo_aplicado    Decimal?                           @db.Decimal(10, 2)
  precio_extras_aplicado         Decimal?                           @db.Decimal(10, 2)
  precio_descuento_aplicado      Decimal?                           @db.Decimal(10, 2)
  porcentaje_trabajador_aplicado Decimal?                           @db.Decimal(5, 2)
  ganancia_trabajador            Decimal?                           @db.Decimal(10, 2)
  comision_plataforma            Decimal?                           @db.Decimal(10, 2)
  cargo_cancelacion              Decimal?                           @db.Decimal(10, 2)
  metodo_pago                    solicitudes_metodo_pago            @default(EFECTIVO)
  adeudo_cobrado                 Decimal?                           @db.Decimal(10, 2)
  estado_pago                    solicitudes_estado_pago            @default(PENDIENTE)
  pago_registrado_en             DateTime?                          @db.DateTime(0)
  pago_registrado_por            solicitudes_pago_registrado_por?
  trabajador_marco_realizado_en  DateTime?                          @db.DateTime(0)
  cliente_marco_realizado_en     DateTime?                          @db.DateTime(0)
  confirmacion_solicitada_en     DateTime?                          @db.DateTime(0)
  aviso_evidencia_en             DateTime?                          @db.DateTime(0)
  realizado_en                   DateTime?                          @db.DateTime(0)
  realizado_via                  solicitudes_realizado_via?
  ganancia_liberada_en           DateTime?                          @db.DateTime(0)
  modo_eleccion                  solicitudes_modo_eleccion          @default(AUTOMATICA)
  solicitud_areas                solicitud_areas[]
  solicitud_extras               solicitud_extras[]
  solicitud_especialidades       solicitud_especialidades[]
  solicitud_trabajadores         solicitud_trabajadores[]
  solicitud_historial            solicitud_historial[]
  trabajador_movimientos         trabajador_movimientos[]
  notificaciones_trabajador      notificaciones_trabajador[]
  descuento_usos                 descuento_usos?
  adeudos_originados             cliente_adeudos[]                  @relation("adeudo_origen")
  adeudos_cobrados               cliente_adeudos[]                  @relation("adeudo_cobro")
  solicitud_reportes             solicitud_reportes[]
  solicitud_resoluciones         solicitud_resoluciones[]

  @@index([servicio_id], map: "fk_sol_servicio")
  @@index([cliente_id, estado], map: "idx_sol_cliente_estado")
  @@index([estado, fecha_hora_programada], map: "idx_sol_estado_fecha")
  @@index([trabajador_id, fecha_hora_programada], map: "idx_sol_trabajador_fecha")
  @@index([inmueble_id], map: "idx_sol_inmueble")
}

model trabajador_horarios {
  id            Int          @id @default(autoincrement())
  trabajador_id Int
  dia_semana    Int          @db.TinyInt
  hora_inicio   DateTime     @db.Time(0)
  hora_fin      DateTime     @db.Time(0)
  trabajadores  trabajadores @relation(fields: [trabajador_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_horario_trabajador")

  @@index([trabajador_id, dia_semana, hora_inicio], map: "idx_horario_trabajador_dia")
}

model trabajador_servicios {
  trabajador_id Int
  servicio_id   Int
  servicios     servicios    @relation(fields: [servicio_id], references: [id], onUpdate: NoAction, map: "fk_ts_servicio")
  trabajadores  trabajadores @relation(fields: [trabajador_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ts_trabajador")

  @@id([trabajador_id, servicio_id])
  @@index([servicio_id], map: "fk_ts_servicio")
}

model trabajadores {
  id                    Int                     @id @default(autoincrement())
  nombre_completo       String                  @db.VarChar(120)
  telefono              String                  @unique(map: "uq_trabajadores_telefono") @db.Char(10)
  correo                String                  @unique(map: "uq_trabajadores_correo") @db.VarChar(150)
  /// Añadido en que-limpiamos-3 (decisión D1, 2026-11-24). Ver docs/backend/sql/001_trabajadores_password_hash.sql
  password_hash         String?                 @db.VarChar(255)
  direccion             String                  @db.VarChar(255)
  foto_url              String?                 @db.VarChar(255)
  estado                trabajadores_estado     @default(ACTIVO)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  updated_at            DateTime                @updatedAt @default(now()) @db.DateTime(0)
  documentos_trabajador documentos_trabajador[]
  solicitudes           solicitudes[]
  trabajador_horarios   trabajador_horarios[]
  trabajador_servicios  trabajador_servicios[]
  estado_verificacion       trabajadores_estado_verificacion @default(PENDIENTE)
  mostrar_fuera_de_horario  Boolean                          @default(false)
  baja_en                   DateTime?                        @db.DateTime(0)
  baja_tipo                 trabajadores_baja_tipo?
  baja_motivo               String?                          @db.VarChar(255)
  identidad_huella          String?                          @unique(map: "uq_trabajadores_identidad") @db.Char(64)
  identidad_registrada_en   DateTime?                        @db.DateTime(0)
  trabajador_especialidades trabajador_especialidades[]
  solicitud_trabajadores    solicitud_trabajadores[]
  trabajador_movimientos    trabajador_movimientos[]
  notificaciones_trabajador notificaciones_trabajador[]
  trabajador_estado_historial trabajador_estado_historial[]
  adeudos_cobrados          cliente_adeudos[]
  solicitud_reportes        solicitud_reportes[]
}

model usuarios {
  id                    Int                           @id @default(autoincrement())
  rol                   usuarios_rol                  @default(CLIENTE)
  nombre_completo       String                        @db.VarChar(120)
  correo                String                        @unique(map: "uq_usuarios_correo") @db.VarChar(150)
  telefono              String?                       @unique(map: "uq_usuarios_telefono") @db.Char(10)
  password_hash         String                        @db.VarChar(255)
  foto_url              String?                       @db.VarChar(255)
  estado_cuenta         usuarios_estado_cuenta        @default(ACTIVA)
  estado_verificacion   usuarios_estado_verificacion? @default(PENDIENTE)
  created_at            DateTime                      @default(now()) @db.DateTime(0)
  documentos_cliente    documentos_cliente[]          @relation("documentos_cliente_dueno")
  documentos_cliente_revisados    documentos_cliente[]    @relation("documentos_cliente_revisor")
  documentos_trabajador_revisados documentos_trabajador[] @relation("documentos_trabajador_revisor")
  trabajador_estado_historial     trabajador_estado_historial[]
  descuentos_creados              descuentos[]
  descuento_usos                  descuento_usos[]
  cliente_adeudos                 cliente_adeudos[]
  solicitud_reportes              solicitud_reportes[]
  solicitud_resoluciones          solicitud_resoluciones[]
  inmuebles             inmuebles[]
  notificaciones        notificaciones[]
  password_reset_tokens password_reset_tokens[]
  solicitudes           solicitudes[]
  identidad_huella      String?                       @unique(map: "uq_usuarios_identidad") @db.Char(64)
  identidad_registrada_en DateTime?                   @db.DateTime(0)
}

model inmuebles {
  id           Int            @id @default(autoincrement())
  usuario_id   Int
  alias        String?        @db.VarChar(100)
  tipo         inmuebles_tipo @default(CASA)
  direccion    String         @db.VarChar(255)
  habitaciones Int            @default(0) @db.UnsignedTinyInt
  banos        Int            @default(0) @db.UnsignedTinyInt
  medios_banos Int            @default(0) @db.UnsignedTinyInt
  pisos        Int            @default(1) @db.UnsignedTinyInt
  created_at   DateTime       @default(now()) @db.DateTime(0)
  updated_at   DateTime       @updatedAt @default(now()) @db.DateTime(0)
  usuarios     usuarios       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inmueble_usuario")
  solicitudes  solicitudes[]
  archivado_en DateTime?      @db.DateTime(0)

  @@index([usuario_id], map: "idx_inmueble_usuario")
}

enum usuarios_rol {
  CLIENTE
  ADMIN
}

enum documentos_cliente_tipo {
  INE_FRENTE
  INE_REVERSO
}

enum documentos_trabajador_tipo {
  IDENTIFICACION
  COMPROBANTE_DOMICILIO
}

enum notificaciones_tipo {
  SERVICIO_CONFIRMADO
  CALIFICAR_SERVICIO
  INVITACION_RECHAZADA
  INVITACIONES_RECHAZADAS
  SOLICITUD_DEVUELTA_A_BOLSA
  DOCUMENTOS_APROBADOS
  DOCUMENTOS_RECHAZADOS
  SERVICIO_CANCELADO_POR_PLATAFORMA
  ADEUDO_REGISTRADO
  CONFIRMAR_SERVICIO_REALIZADO
  AVISO_CONFIRMACION_CON_EVIDENCIA
  SERVICIO_CONFIRMADO_AUTOMATICAMENTE
  REPORTE_REGISTRADO
  REPORTE_RESUELTO
}

enum trabajadores_estado {
  ACTIVO
  INACTIVO
  BAJA
}

enum servicios_estado {
  ACTIVO
  INACTIVO
}

enum usuarios_estado_cuenta {
  ACTIVA
  SUSPENDIDA
}

enum usuarios_estado_verificacion {
  PENDIENTE
  VERIFICADO
  RECHAZADO
}

enum solicitudes_estado {
  PENDIENTE
  CONFIRMADO
  EN_PROCESO
  REALIZADO
  CANCELADO
  RECHAZADO
}

enum inmuebles_tipo {
  CASA
  OFICINA
  DEPARTAMENTO
}

// ════════ Nuevos (SQL 002 v9) ════════
/// Descuentos creados por el admin. La plataforma absorbe la pérdida.
model descuentos {
  id                      Int                   @id @default(autoincrement())
  nombre                  String                @db.VarChar(100)
  descripcion             String?               @db.VarChar(255)
  tipo                    descuentos_tipo
  valor                   Decimal               @db.Decimal(10, 2)
  /// NULL = descuento automático (sin código).
  codigo                  String?               @unique(map: "uq_descuentos_codigo") @db.VarChar(40)
  fecha_inicio            DateTime              @db.DateTime(0)
  fecha_fin               DateTime              @db.DateTime(0)
  monto_minimo            Decimal?              @db.Decimal(10, 2)
  todos_los_servicios     Boolean               @default(false)
  limite_usos             Int?                  @db.UnsignedInt
  limite_usos_por_cliente Int?                  @db.UnsignedInt
  activo                  Boolean               @default(true)
  creado_por              Int?
  created_at              DateTime              @default(now()) @db.DateTime(0)
  updated_at              DateTime              @updatedAt @default(now()) @db.DateTime(0)
  usuarios usuarios? @relation(fields: [creado_por], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_descuento_creado_por")
  descuento_servicios     descuento_servicios[]
  descuento_usos          descuento_usos[]

  @@index([activo, fecha_inicio, fecha_fin], map: "idx_descuentos_vigencia")
  @@index([creado_por], map: "idx_descuentos_creado_por")
}

model descuento_servicios {
  descuento_id Int
  servicio_id  Int
  descuentos descuentos @relation(fields: [descuento_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ds_descuento")
  servicios servicios @relation(fields: [servicio_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ds_servicio")

  @@id([descuento_id, servicio_id])
  @@index([servicio_id], map: "idx_ds_servicio")
}

/// Uso de un descuento (uno por solicitud). Se consume aunque la solicitud se cancele.
model descuento_usos {
  id               Int         @id @default(autoincrement())
  descuento_id     Int
  solicitud_id     Int         @unique(map: "uq_du_solicitud")
  cliente_id       Int
  codigo_aplicado  String?     @db.VarChar(40)
  monto_descontado Decimal     @db.Decimal(10, 2)
  created_at       DateTime    @default(now()) @db.DateTime(0)
  descuentos descuentos @relation(fields: [descuento_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_du_descuento")
  solicitudes solicitudes @relation(fields: [solicitud_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_du_solicitud")
  usuarios usuarios @relation(fields: [cliente_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_du_cliente")

  @@index([descuento_id, cliente_id], map: "idx_du_descuento_cliente")
  @@index([cliente_id], map: "idx_du_cliente")
}

/// Adeudos de clientes (cancelación tardía de un servicio en efectivo). Se cobran en su próximo servicio.
model cliente_adeudos {
  id                  Int                    @id @default(autoincrement())
  cliente_id          Int
  solicitud_origen_id Int                    @unique(map: "uq_adeudo_origen")
  motivo              cliente_adeudos_motivo
  monto               Decimal                @db.Decimal(10, 2)
  estado              cliente_adeudos_estado @default(PENDIENTE)
  solicitud_cobro_id  Int?
  trabajador_cobro_id Int?
  cobrado_en          DateTime?              @db.DateTime(0)
  /// Cuándo y con qué dinero se pagó la compensación del trabajador afectado (una sola vez).
  compensacion_liberada_en DateTime?                                @db.DateTime(0)
  compensacion_pagada_por  cliente_adeudos_compensacion_pagada_por?
  created_at          DateTime               @default(now()) @db.DateTime(0)
  updated_at          DateTime               @updatedAt @default(now()) @db.DateTime(0)
  usuarios usuarios @relation(fields: [cliente_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_adeudo_cliente")
  solicitud_origen solicitudes @relation("adeudo_origen", fields: [solicitud_origen_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_adeudo_origen")
  solicitud_cobro solicitudes? @relation("adeudo_cobro", fields: [solicitud_cobro_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_adeudo_cobro")
  trabajadores trabajadores? @relation(fields: [trabajador_cobro_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_adeudo_trabajador")

  @@index([cliente_id, estado], map: "idx_adeudo_cliente_estado")
  @@index([solicitud_cobro_id], map: "idx_adeudo_cobro")
  @@index([trabajador_cobro_id], map: "idx_adeudo_trabajador")
}

/// Historial de estados del trabajador (activar/desactivar, bajas, reactivaciones).
model trabajador_estado_historial {
  id              Int                                          @id @default(autoincrement())
  trabajador_id   Int
  estado_anterior trabajador_estado_historial_estado_anterior?
  estado_nuevo    trabajador_estado_historial_estado_nuevo
  tipo            trabajador_estado_historial_tipo
  actor           trabajador_estado_historial_actor
  admin_id        Int?
  motivo          String?                                      @db.VarChar(255)
  created_at      DateTime                                     @default(now()) @db.DateTime(0)
  trabajadores trabajadores @relation(fields: [trabajador_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_teh_trabajador")
  usuarios usuarios? @relation(fields: [admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_teh_admin")

  @@index([trabajador_id, created_at], map: "idx_teh_trabajador")
