  solicitud_id    Int
  estado_anterior solicitud_historial_estado_anterior?
  estado_nuevo    solicitud_historial_estado_nuevo
  actor           solicitud_historial_actor
  /// usuarios.id si actor=CLIENTE/ADMIN, trabajadores.id si actor=TRABAJADOR, NULL si SISTEMA (sin FK).
  actor_id        Int?
  motivo          String?                              @db.VarChar(255)
  created_at      DateTime                             @default(now()) @db.DateTime(0)
  solicitudes solicitudes @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hist_solicitud")

  @@index([solicitud_id, created_at], map: "idx_hist_solicitud")
  @@index([actor, actor_id], map: "idx_hist_actor")
}

/// Resoluciones del admin (inmutables; manda la más reciente). NULL = esa resolución no cambia ese eje.
model solicitud_resoluciones {
  id                     Int                                        @id @default(autoincrement())
  solicitud_id           Int
  admin_id               Int?
  resultado_servicio     solicitud_resoluciones_resultado_servicio?
  resultado_pago         solicitud_resoluciones_resultado_pago?
  motivo                 String                                     @db.VarChar(500)
  created_at             DateTime                                   @default(now()) @db.DateTime(0)
  solicitudes solicitudes @relation(fields: [solicitud_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_res_solicitud")
  usuarios usuarios? @relation(fields: [admin_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_res_admin")
  solicitud_reportes     solicitud_reportes[]
  trabajador_movimientos trabajador_movimientos[]

  @@index([solicitud_id, created_at], map: "idx_res_solicitud")
  @@index([admin_id], map: "idx_res_admin")
}

/// Reportes e incidencias de un servicio (cliente o trabajador). Se conservan siempre.
model solicitud_reportes {
  id                   Int                              @id @default(autoincrement())
  solicitud_id         Int
  reportado_por        solicitud_reportes_reportado_por
  /// usuarios.id si reportado_por = CLIENTE.
  cliente_id           Int?
  /// trabajadores.id si reportado_por = TRABAJADOR.
  trabajador_id        Int?
  tipo                 solicitud_reportes_tipo
  descripcion          String?                          @db.Text
  estado               solicitud_reportes_estado        @default(ABIERTO)
  resolucion_id        Int?
  created_at           DateTime                         @default(now()) @db.DateTime(0)
  updated_at           DateTime                         @updatedAt @default(now()) @db.DateTime(0)
  solicitudes solicitudes @relation(fields: [solicitud_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_rep_solicitud")
  usuarios usuarios? @relation(fields: [cliente_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_rep_cliente")
  trabajadores trabajadores? @relation(fields: [trabajador_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_rep_trabajador")
  solicitud_resoluciones solicitud_resoluciones? @relation(fields: [resolucion_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_rep_resolucion")
  evidencias_solicitud evidencias_solicitud[]

  @@index([solicitud_id, estado], map: "idx_rep_solicitud_estado")
  @@index([estado, created_at], map: "idx_rep_estado")
  @@index([cliente_id], map: "idx_rep_cliente")
  @@index([trabajador_id], map: "idx_rep_trabajador")
  @@index([resolucion_id], map: "idx_rep_resolucion")
}

/// Libro de movimientos del trabajador. INMUTABLE: solo INSERT; correcciones con AJUSTE.
model trabajador_movimientos {
  id                             Int                           @id @default(autoincrement())
  trabajador_id                  Int
  cuenta                         trabajador_movimientos_cuenta
  tipo                           trabajador_movimientos_tipo
  /// Con signo: + aumenta la cuenta, − la disminuye.
  monto                          Decimal                       @db.Decimal(10, 2)
  /// Saldo de ESTA cuenta después del movimiento.
  saldo_resultante               Decimal                       @db.Decimal(10, 2)
  /// % usado para calcular el monto (85 en ganancias, 10 en retenciones…).
  porcentaje_aplicado            Decimal?                      @db.Decimal(5, 2)
  solicitud_id                   Int?
  movimiento_relacionado_id      Int?
  /// Resolución del admin que ordenó este movimiento (p. ej. un AJUSTE).
  resolucion_id                  Int?
  referencia_externa             String?                       @db.VarChar(100)
  descripcion                    String?                       @db.VarChar(255)
  clave_idempotencia             String                        @unique(map: "uq_mov_idempotencia") @db.VarChar(100)
  created_at                     DateTime                      @default(now()) @db.DateTime(0)
  /// Columna GENERADA por la BD (VIRTUAL): una vez por (tipo, solicitud, trabajador). Nunca escribirla.
  clave_unica_solicitud          String?                       @unique(map: "uq_mov_una_vez_por_solicitud") @ignore @db.VarChar(80)
  /// Columna GENERADA por la BD (VIRTUAL): cada movimiento se libera y se corrige una sola vez. Nunca escribirla.
  clave_unica_referencia         String?                       @unique(map: "uq_mov_una_vez_por_movimiento") @ignore @db.VarChar(50)
  trabajadores trabajadores @relation(fields: [trabajador_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mov_trabajador")
  solicitudes solicitudes? @relation(fields: [solicitud_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mov_solicitud")
  movimiento_relacionado trabajador_movimientos? @relation("movimiento_relacionado", fields: [movimiento_relacionado_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mov_relacionado")
  movimientos_que_lo_referencian trabajador_movimientos[]      @relation("movimiento_relacionado")
  solicitud_resoluciones solicitud_resoluciones? @relation(fields: [resolucion_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mov_resolucion")

  @@index([trabajador_id, cuenta, id], map: "idx_mov_trabajador_cuenta")
  @@index([solicitud_id], map: "idx_mov_solicitud")
  @@index([movimiento_relacionado_id], map: "idx_mov_relacionado")
  @@index([resolucion_id], map: "idx_mov_resolucion")
}

model notificaciones_trabajador {
  id            Int                            @id @default(autoincrement())
  trabajador_id Int
  solicitud_id  Int?
  tipo          notificaciones_trabajador_tipo
  titulo        String                         @db.VarChar(100)
