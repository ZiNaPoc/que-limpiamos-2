# Copia este archivo como .env y rellena los valores. Nunca subas .env a git.

# --- Base de datos (runtime: adapter MariaDB con TLS) ---
DATABASE_HOST=
DATABASE_PORT=4000
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# --- Solo para la CLI de Prisma (prisma.config.ts). Mismos datos que arriba ---
DATABASE_URL='mysql://USER:PASSWORD@HOST:4000/DATABASE_NAME?sslaccept=strict'

# --- Servidor ---
# En Render, PORT lo asigna la plataforma.
PORT=3000
# development | production (production activa cookies secure + sameSite=none)
NODE_ENV=development
# Orígenes del panel web separados por coma
CORS_ORIGINS=http://localhost:5173

# --- Autenticación (Fase 2) ---
# Un secreto DISTINTO por audiencia, de al menos 32 caracteres. Sin ellos el servidor no arranca.
# Generar cada uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_CLIENTE=
JWT_SECRET_TRABAJADOR=
JWT_SECRET_ADMIN=
# Opcionales: vigencia de la sesión en segundos (por defecto 7 días para las apps, 8 h para el panel).
# JWT_EXPIRACION_CLIENTE_SEG=604800
# JWT_EXPIRACION_TRABAJADOR_SEG=604800
# JWT_EXPIRACION_ADMIN_SEG=28800
# Opcional: costo de bcrypt (por defecto 12; mínimo 10 fuera de las pruebas).
# BCRYPT_ROUNDS=12

# --- Pruebas automatizadas (npm test) ---
# BD vacía donde se crean las tablas de prueba (por defecto queLimpiamos_proyecto). Nunca producción.
# PRUEBAS_DATABASE_NAME=queLimpiamos_proyecto

# --- Límite de intentos (opcionales; por defecto 30 / 10 / 10 por IP) ---
# LIMITE_LOGIN_POR_IP=30
# LIMITE_REGISTRO_POR_IP=10
# LIMITE_PASSWORD_POR_IP=10

# --- Almacenamiento de archivos (D5: local y privado, sin proveedores de pago) ---
# Carpeta FUERA del repositorio (el backend se niega a usar una dentro). Por defecto: <home>/.quelimpiamos/almacenamiento
# ALMACENAMIENTO_LOCAL_DIR=
# Secreto (32+ caracteres) para firmar las URLs temporales. Si falta, se genera uno por arranque.
# ALMACENAMIENTO_FIRMA_SECRETO=
# ALMACENAMIENTO_MAX_MB=5
# ⚠ En Render el disco NO es persistente: el almacenamiento local sirve solo para demostraciones.

# --- Demo local (npm run demo:local) ---
# DEMO_DATABASE_NAME=queLimpiamos_proyecto
