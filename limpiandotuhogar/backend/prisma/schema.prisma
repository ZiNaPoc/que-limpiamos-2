// Generado con `npm run prisma:local` desde la BD LOCAL (000 + 002 v10 + 003 v2). Las columnas
// GENERADAS por la BD van con @ignore. Producción NO tiene todavía el 002 ni el 003 v2.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model admin_permisos {
  id                                                                              Int                      @id @default(autoincrement())
  usuario_id                                                                      Int
  permiso                                                                         admin_permisos_permiso
  origen                                                                          admin_permisos_origen
  otorgado_por                                                                    Int?
  otorgado_en                                                                     DateTime                 @default(now()) @db.DateTime(0)
  motivo                                                                          String?                  @db.VarChar(255)
  revocado_por                                                                    Int?
  revocado_en                                                                     DateTime?                @db.DateTime(0)
  motivo_revocacion                                                               String?                  @db.VarChar(255)
  permiso_activo                                                                  String?                  @unique(map: "uq_permiso_activo") @db.VarChar(80) @ignore
  regla_otorgamiento                                                              Int?                     @db.TinyInt @ignore
  regla_revocacion                                                                Int?                     @db.TinyInt @ignore
  usuarios_admin_permisos_otorgado_porTousuarios                                  usuarios?                @relation("admin_permisos_otorgado_porTousuarios", fields: [otorgado_por], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_permiso_otorgado_por")
  usuarios_admin_permisos_revocado_porTousuarios                                  usuarios?                @relation("admin_permisos_revocado_porTousuarios", fields: [revocado_por], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_permiso_revocado_por")
  usuarios_admin_permisos_usuario_idTousuarios                                    usuarios                 @relation("admin_permisos_usuario_idTousuarios", fields: [usuario_id], references: [id], onUpdate: NoAction, map: "fk_permiso_usuario")
  moderacion_eventos_moderacion_eventos_admin_permiso_id_admin_idToadmin_permisos moderacion_eventos[]     @relation("moderacion_eventos_admin_permiso_id_admin_idToadmin_permisos")
  moderacion_eventos_moderacion_eventos_permiso_idToadmin_permisos                moderacion_eventos[]     @relation("moderacion_eventos_permiso_idToadmin_permisos")
  solicitud_resoluciones                                                          solicitud_resoluciones[]

  @@unique([id, usuario_id], map: "uq_permiso_id_usuario")
  @@index([otorgado_por], map: "idx_permiso_otorgado_por")
  @@index([revocado_por], map: "idx_permiso_revocado_por")
  @@index([usuario_id], map: "idx_permiso_usuario")
}

model areas_limpieza {
  id              Int                   @id @default(autoincrement())
  nombre          String                @unique(map: "uq_areas_limpieza_nombre") @db.VarChar(60)
  orden           Int                   @default(0) @db.UnsignedTinyInt
  estado          areas_limpieza_estado @default(ACTIVO)
  solicitud_areas solicitud_areas[]
}

model cliente_adeudos {
  id                                                           Int                                      @id @default(autoincrement())
  cliente_id                                                   Int
  solicitud_origen_id                                          Int                                      @unique(map: "uq_adeudo_origen")
  motivo                                                       cliente_adeudos_motivo
  monto                                                        Decimal                                  @db.Decimal(10, 2)
  estado                                                       cliente_adeudos_estado                   @default(PENDIENTE)
  solicitud_cobro_id                                           Int?
  trabajador_cobro_id                                          Int?
  cobrado_en                                                   DateTime?                                @db.DateTime(0)
  compensacion_liberada_en                                     DateTime?                                @db.DateTime(0)
  compensacion_pagada_por                                      cliente_adeudos_compensacion_pagada_por?
  created_at                                                   DateTime                                 @default(now()) @db.DateTime(0)
  updated_at                                                   DateTime                                 @default(now()) @db.DateTime(0)
  usuarios                                                     usuarios                                 @relation(fields: [cliente_id], references: [id], onUpdate: NoAction, map: "fk_adeudo_cliente")
  solicitudes_cliente_adeudos_solicitud_cobro_idTosolicitudes  solicitudes?                             @relation("cliente_adeudos_solicitud_cobro_idTosolicitudes", fields: [solicitud_cobro_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_adeudo_cobro")
  solicitudes_cliente_adeudos_solicitud_origen_idTosolicitudes solicitudes                              @relation("cliente_adeudos_solicitud_origen_idTosolicitudes", fields: [solicitud_origen_id], references: [id], onUpdate: NoAction, map: "fk_adeudo_origen")
  trabajadores                                                 trabajadores?                            @relation(fields: [trabajador_cobro_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_adeudo_trabajador")

  @@index([cliente_id, estado], map: "idx_adeudo_cliente_estado")
  @@index([solicitud_cobro_id], map: "idx_adeudo_cobro")
  @@index([trabajador_cobro_id], map: "idx_adeudo_trabajador")
}

model descuento_servicios {
  descuento_id Int
  servicio_id  Int
  descuentos   descuentos @relation(fields: [descuento_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ds_descuento")
  servicios    servicios  @relation(fields: [servicio_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ds_servicio")

  @@id([descuento_id, servicio_id])
  @@index([servicio_id], map: "idx_ds_servicio")
}

model descuento_usos {
  id               Int         @id @default(autoincrement())
  descuento_id     Int
  solicitud_id     Int         @unique(map: "uq_du_solicitud")
  cliente_id       Int
  codigo_aplicado  String?     @db.VarChar(40)
  monto_descontado Decimal     @db.Decimal(10, 2)
  created_at       DateTime    @default(now()) @db.DateTime(0)
  usuarios         usuarios    @relation(fields: [cliente_id], references: [id], onUpdate: NoAction, map: "fk_du_cliente")
  descuentos       descuentos  @relation(fields: [descuento_id], references: [id], onUpdate: NoAction, map: "fk_du_descuento")
  solicitudes      solicitudes @relation(fields: [solicitud_id], references: [id], onUpdate: NoAction, map: "fk_du_solicitud")

  @@index([cliente_id], map: "idx_du_cliente")
  @@index([descuento_id, cliente_id], map: "idx_du_descuento_cliente")
}

model descuentos {
  id                      Int                   @id @default(autoincrement())
  nombre                  String                @db.VarChar(100)
  descripcion             String?               @db.VarChar(255)
  tipo                    descuentos_tipo
  valor                   Decimal               @db.Decimal(10, 2)
  codigo                  String?               @unique(map: "uq_descuentos_codigo") @db.VarChar(40)
  fecha_inicio            DateTime              @db.DateTime(0)
  fecha_fin               DateTime              @db.DateTime(0)
  monto_minimo            Decimal?              @db.Decimal(10, 2)
  todos_los_servicios     Boolean               @default(false)
  limite_usos             Int?                  @db.UnsignedInt
  limite_usos_por_cliente Int?                  @db.UnsignedInt
  activo                  Boolean               @default(true)
  creado_por              Int?
  created_at              DateTime              @default(now()) @db.DateTime(0)
  updated_at              DateTime              @default(now()) @db.DateTime(0)
  descuento_servicios     descuento_servicios[]
  descuento_usos          descuento_usos[]
  usuarios                usuarios?             @relation(fields: [creado_por], references: [id], onUpdate: NoAction, map: "fk_descuento_creado_por")

  @@index([creado_por], map: "idx_descuentos_creado_por")
  @@index([activo, fecha_inicio, fecha_fin], map: "idx_descuentos_vigencia")
}

model documentos_cliente {
  id                                                 Int                       @id @default(autoincrement())
  usuario_id                                         Int
  tipo                                               documentos_cliente_tipo
  archivo_url                                        String                    @db.VarChar(255)
  estado                                             documentos_cliente_estado @default(PENDIENTE)
  motivo_rechazo                                     String?                   @db.VarChar(255)
  revisado_en                                        DateTime?                 @db.DateTime(0)
  revisado_por                                       Int?
  archivo_eliminado_en                               DateTime?                 @db.DateTime(0)
  created_at                                         DateTime                  @default(now()) @db.DateTime(0)
  usuarios_documentos_cliente_revisado_porTousuarios usuarios?                 @relation("documentos_cliente_revisado_porTousuarios", fields: [revisado_por], references: [id], onUpdate: NoAction, map: "fk_doc_cliente_revisor")
  usuarios_documentos_cliente_usuario_idTousuarios   usuarios                  @relation("documentos_cliente_usuario_idTousuarios", fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_cliente_usuario")

  @@unique([usuario_id, tipo], map: "uq_doc_cliente_tipo")
  @@index([revisado_por], map: "idx_doc_cliente_revisor")
}

model documentos_trabajador {
  id                   Int                          @id @default(autoincrement())
  trabajador_id        Int
  tipo                 documentos_trabajador_tipo
  archivo_url          String                       @db.VarChar(255)
  estado               documentos_trabajador_estado @default(PENDIENTE)
  motivo_rechazo       String?                      @db.VarChar(255)
  revisado_en          DateTime?                    @db.DateTime(0)
  revisado_por         Int?
  archivo_eliminado_en DateTime?                    @db.DateTime(0)
  created_at           DateTime                     @default(now()) @db.DateTime(0)
  trabajadores         trabajadores                 @relation(fields: [trabajador_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_trabajador")
  usuarios             usuarios?                    @relation(fields: [revisado_por], references: [id], onUpdate: NoAction, map: "fk_doc_trabajador_revisor")

  @@unique([trabajador_id, tipo], map: "uq_doc_trabajador_tipo")
  @@index([revisado_por], map: "idx_doc_trabajador_revisor")
}

model especialidades {
  id                        Int                         @id @default(autoincrement())
  nombre                    String                      @unique(map: "uq_especialidades_nombre") @db.VarChar(100)
  descripcion               String?                     @db.VarChar(255)
  estado                    especialidades_estado       @default(ACTIVO)
  created_at                DateTime                    @default(now()) @db.DateTime(0)
  updated_at                DateTime                    @default(now()) @db.DateTime(0)
  extra_especialidades      extra_especialidades[]
  servicio_especialidades   servicio_especialidades[]
  solicitud_especialidades  solicitud_especialidades[]
  trabajador_especialidades trabajador_especialidades[]
}

model evidencias_solicitud {
  id                 Int                               @id @default(autoincrement())
  solicitud_id       Int
  archivo_url        String                            @db.VarChar(255)
  tipo_mime          String?                           @db.VarChar(50)
  tamano_bytes       Int?                              @db.UnsignedInt
  sha256             String?                           @db.Char(64)
  descripcion        String?                           @db.VarChar(255)
  aportada_por       evidencias_solicitud_aportada_por @default(TRABAJADOR)
  reporte_id         Int?
  created_at         DateTime                          @default(now()) @db.DateTime(0)
  eliminada_en       DateTime?                         @db.DateTime(0)
  eliminada_por      Int?
  regla_eliminacion  Int?                              @db.TinyInt @ignore
  usuarios           usuarios?                         @relation(fields: [eliminada_por], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_evid_eliminada_por")
  solicitud_reportes solicitud_reportes?               @relation(fields: [reporte_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_evid_reporte")
  solicitudes        solicitudes                       @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_evid_solicitud")

  @@index([solicitud_id], map: "fk_evid_solicitud")
  @@index([eliminada_por], map: "idx_evid_eliminada_por")
  @@index([reporte_id], map: "idx_evid_reporte")
}

model extra_especialidades {
  extra_id        Int
  especialidad_id Int
  especialidades  especialidades  @relation(fields: [especialidad_id], references: [id], onUpdate: NoAction, map: "fk_eesp_especialidad")
  servicios_extra servicios_extra @relation(fields: [extra_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_eesp_extra")

  @@id([extra_id, especialidad_id])
  @@index([especialidad_id], map: "idx_eesp_especialidad")
}

model inmuebles {
  id           Int            @id @default(autoincrement())
  usuario_id   Int
  alias        String?        @db.VarChar(100)
  tipo         inmuebles_tipo @default(CASA)
  direccion    String         @db.VarChar(255)
  habitaciones Int            @default(0) @db.UnsignedTinyInt
  banos        Int            @default(0) @db.UnsignedTinyInt
  medios_banos Int            @default(0) @db.UnsignedTinyInt
  pisos        Int            @default(1) @db.UnsignedTinyInt
  archivado_en DateTime?      @db.DateTime(0)
  created_at   DateTime       @default(now()) @db.DateTime(0)
  updated_at   DateTime       @default(now()) @db.DateTime(0)
  usuarios     usuarios       @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_inmueble_usuario")
  solicitudes  solicitudes[]

  @@index([usuario_id], map: "idx_inmueble_usuario")
}

model moderacion_eventos {
  id                                                                          Int                          @id @default(autoincrement())
  admin_id                                                                    Int?
  admin_permiso_id                                                            Int?
  entidad                                                                     moderacion_eventos_entidad
  resena_id                                                                   Int?
  reporte_id                                                                  Int?
  permiso_id                                                                  Int?
  operacion                                                                   moderacion_eventos_operacion
  datos_anteriores                                                            Json
  datos_nuevos                                                                Json
  motivo                                                                      String                       @db.VarChar(500)
  created_at                                                                  DateTime                     @default(now()) @db.DateTime(0)
  regla_objetivo                                                              Int?                         @db.TinyInt @ignore
  regla_actor                                                                 Int?                         @db.TinyInt @ignore
  usuarios                                                                    usuarios?                    @relation(fields: [admin_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mod_admin")
  admin_permisos_moderacion_eventos_admin_permiso_id_admin_idToadmin_permisos admin_permisos?              @relation("moderacion_eventos_admin_permiso_id_admin_idToadmin_permisos", fields: [admin_permiso_id, admin_id], references: [id, usuario_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mod_permiso")
  admin_permisos_moderacion_eventos_permiso_idToadmin_permisos                admin_permisos?              @relation("moderacion_eventos_permiso_idToadmin_permisos", fields: [permiso_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mod_permiso_objetivo")
  solicitud_reportes                                                          solicitud_reportes?          @relation(fields: [reporte_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mod_reporte")
  resenas                                                                     resenas?                     @relation(fields: [resena_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mod_resena")

  @@index([admin_id, created_at], map: "idx_mod_admin")
  @@index([admin_permiso_id, admin_id], map: "idx_mod_permiso")
  @@index([permiso_id, created_at], map: "idx_mod_permiso_objetivo")
  @@index([reporte_id, created_at], map: "idx_mod_reporte")
  @@index([resena_id, created_at], map: "idx_mod_resena")
}

model notificaciones {
  id           Int                 @id @default(autoincrement())
  usuario_id   Int
  solicitud_id Int?
  tipo         notificaciones_tipo
  clave_evento String              @db.VarChar(120)
  titulo       String              @db.VarChar(100)
  mensaje      String              @db.VarChar(255)
  leida_en     DateTime?           @db.DateTime(0)
  created_at   DateTime            @default(now()) @db.DateTime(0)
  solicitudes  solicitudes?        @relation(fields: [solicitud_id], references: [id], onUpdate: NoAction, map: "fk_notif_solicitud")
  usuarios     usuarios            @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notif_usuario")

  @@unique([usuario_id, clave_evento], map: "uq_notif_evento")
  @@index([solicitud_id], map: "fk_notif_solicitud")
  @@index([usuario_id], map: "fk_notif_usuario")
  @@index([usuario_id, leida_en], map: "idx_notif_usuario_leida")
}

model notificaciones_trabajador {
  id            Int                            @id @default(autoincrement())
  trabajador_id Int
  solicitud_id  Int?
  tipo          notificaciones_trabajador_tipo
  clave_evento  String                         @db.VarChar(120)
  titulo        String                         @db.VarChar(100)
  mensaje       String                         @db.VarChar(255)
  leida_en      DateTime?                      @db.DateTime(0)
  created_at    DateTime                       @default(now()) @db.DateTime(0)
  solicitudes   solicitudes?                   @relation(fields: [solicitud_id], references: [id], onUpdate: NoAction, map: "fk_notif_trab_solicitud")
  trabajadores  trabajadores                   @relation(fields: [trabajador_id], references: [id], onUpdate: NoAction, map: "fk_notif_trab_trabajador")

  @@unique([trabajador_id, clave_evento], map: "uq_notif_trab_evento")
  @@index([trabajador_id, leida_en], map: "idx_notif_trab_leida")
  @@index([solicitud_id], map: "idx_notif_trab_solicitud")
}

model parametros_negocio {
  clave       String   @id @db.VarChar(60)
  valor       Decimal  @db.Decimal(10, 2)
  descripcion String   @db.VarChar(255)
  updated_at  DateTime @default(now()) @db.DateTime(0)
}

model password_reset_tokens {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  token_hash String   @unique(map: "uq_reset_token") @db.Char(64)
  expira_en  DateTime @db.DateTime(0)
  usado      Boolean  @default(false)
  created_at DateTime @default(now()) @db.DateTime(0)
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reset_usuario")

  @@index([usuario_id], map: "fk_reset_usuario")
}

model reglas_cargo_cancelacion {
  id          Int                               @id @default(autoincrement())
  aplica_a    reglas_cargo_cancelacion_aplica_a
  horas_antes Int                               @db.UnsignedSmallInt
  tipo        reglas_cargo_cancelacion_tipo     @default(PORCENTAJE)
  valor       Decimal                           @default(0.00) @db.Decimal(10, 2)
  estado      reglas_cargo_cancelacion_estado   @default(ACTIVO)
  created_at  DateTime                          @default(now()) @db.DateTime(0)
  updated_at  DateTime                          @default(now()) @db.DateTime(0)

  @@unique([aplica_a, horas_antes], map: "uq_regla_cargo")
}

model resenas {
  id                                                          Int                  @id @default(autoincrement())
  solicitud_id                                                Int
  autor_rol                                                   resenas_autor_rol
  cliente_id                                                  Int
  trabajador_id                                               Int
  puntuacion                                                  Int                  @db.UnsignedTinyInt
  comentario                                                  String?              @db.Text
  created_at                                                  DateTime             @default(now()) @db.DateTime(0)
  editada_en                                                  DateTime?            @db.DateTime(0)
  eliminada_en                                                DateTime?            @db.DateTime(0)
  eliminada_por                                               Int?
  regla_eliminacion                                           Int?                 @db.TinyInt @ignore
  moderacion_eventos                                          moderacion_eventos[]
  usuarios                                                    usuarios?            @relation(fields: [eliminada_por], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_resena_eliminada_por")
  solicitudes_resenas_solicitud_id_cliente_idTosolicitudes    solicitudes          @relation("resenas_solicitud_id_cliente_idTosolicitudes", fields: [solicitud_id, cliente_id], references: [id, cliente_id], onUpdate: NoAction, map: "fk_resena_sol_cliente")
  solicitudes_resenas_solicitud_id_trabajador_idTosolicitudes solicitudes          @relation("resenas_solicitud_id_trabajador_idTosolicitudes", fields: [solicitud_id, trabajador_id], references: [id, trabajador_id], onUpdate: NoAction, map: "fk_resena_sol_trabajador")

  @@unique([solicitud_id, autor_rol], map: "uq_resena_solicitud_autor")
  @@index([cliente_id, autor_rol, eliminada_en], map: "idx_resena_cliente")
  @@index([eliminada_por], map: "idx_resena_eliminada_por")
  @@index([solicitud_id, cliente_id], map: "idx_resena_sol_cliente")
  @@index([solicitud_id, trabajador_id], map: "idx_resena_sol_trabajador")
  @@index([trabajador_id, autor_rol, eliminada_en], map: "idx_resena_trabajador")
}

model servicio_calculo {
  servicio_id            Int       @id
  precio_por_habitacion  Decimal   @default(0.00) @db.Decimal(10, 2)
  precio_por_bano        Decimal   @default(0.00) @db.Decimal(10, 2)
  precio_por_medio_bano  Decimal   @default(0.00) @db.Decimal(10, 2)
  precio_por_piso        Decimal   @default(0.00) @db.Decimal(10, 2)
  minutos_por_habitacion Int       @default(0) @db.UnsignedSmallInt
  minutos_por_bano       Int       @default(0) @db.UnsignedSmallInt
  minutos_por_medio_bano Int       @default(0) @db.UnsignedSmallInt
  minutos_por_piso       Int       @default(0) @db.UnsignedSmallInt
  updated_at             DateTime  @default(now()) @db.DateTime(0)
  servicios              servicios @relation(fields: [servicio_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_calculo_servicio")
}

model servicio_calculo_tipo_inmueble {
  servicio_id            Int
  tipo_inmueble          servicio_calculo_tipo_inmueble_tipo_inmueble
  multiplicador_precio   Decimal                                      @default(1.00) @db.Decimal(5, 2)
  multiplicador_duracion Decimal                                      @default(1.00) @db.Decimal(5, 2)
  updated_at             DateTime                                     @default(now()) @db.DateTime(0)
  servicios              servicios                                    @relation(fields: [servicio_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_calculo_tipo_servicio")

  @@id([servicio_id, tipo_inmueble])
}

model servicio_especialidades {
  servicio_id     Int
  especialidad_id Int
  especialidades  especialidades @relation(fields: [especialidad_id], references: [id], onUpdate: NoAction, map: "fk_sesp_especialidad")
  servicios       servicios      @relation(fields: [servicio_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sesp_servicio")

  @@id([servicio_id, especialidad_id])
  @@index([especialidad_id], map: "idx_sesp_especialidad")
}

model servicios {
  id                             Int                              @id @default(autoincrement())
  nombre                         String                           @unique(map: "uq_servicios_nombre") @db.VarChar(100)
  descripcion                    String                           @db.Text
  precio_base                    Decimal                          @db.Decimal(10, 2)
  duracion_estimada_min          Int                              @default(300) @db.UnsignedSmallInt
  imagen_url                     String?                          @db.VarChar(255)
  estado                         servicios_estado                 @default(ACTIVO)
  created_at                     DateTime                         @default(now()) @db.DateTime(0)
  updated_at                     DateTime                         @default(now()) @db.DateTime(0)
