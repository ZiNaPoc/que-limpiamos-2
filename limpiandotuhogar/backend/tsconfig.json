{
  "compilerOptions": {
    "target": "es2025",
    "lib": [
      "ES2025"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "generated",
    "prisma.config.ts",
    "test"
  ]
}
